<Window x:Class="rpgFogOfWar.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="Control (DM Screen)"
        Height="950"
        Width="1350"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">

        <Grid>
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="325"/>
                        <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0">
                                <StackPanel.Background>
                                        <LinearGradientBrush StartPoint="0,0"
                                                             EndPoint="1,1">
                                                <GradientStop Color="#FF1E3A8A" Offset="0.0"/>
                                                <GradientStop Color="#FF3B82F6" Offset="0.5"/>
                                                <GradientStop Color="#FF60A5FA" Offset="1.0"/>
                                        </LinearGradientBrush>
                                </StackPanel.Background>

                                <TextBlock Text="FOW Battle Map Tool"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="10,10,10,20"
                                           Foreground="White"/>

                                <Button Content="Load Image (F)"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Click="LoadImage_Click"
                                        Margin="5"
                                        Height="40"
                                        FontSize="14"/>
                                <StackPanel Orientation="Horizontal">
                                        <Button Content="Save state (Ctrl+S)"
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                Click="SaveSession_Click"
                                                Margin="5"
                                                Height="40"
                                                FontSize="13"/>
                                        <Button Content="Load state (Ctrl+O)"
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                Click="LoadSession_Click"
                                                Margin="5"
                                                Height="40"
                                                FontSize="13"/>
                                </StackPanel>

                                <TextBlock Text="Audience display"
                                           FontSize="14"
                                           Margin="10,15,10,5"
                                           Foreground="White"/>
                                <ComboBox x:Name="DisplayCombo"
                                          Style="{StaticResource MaterialDesignComboBox}"
                                          Margin="8"
                                          Height="40"
                                          Foreground="White"
                                          SelectionChanged="DisplayCombo_SelectionChanged"/>

                                <TextBlock Text="Fog tool"
                                           FontSize="14"
                                           Margin="10,15,10,5"
                                           Foreground="White"/>
                                <StackPanel Orientation="Horizontal" Margin="8">
                                        <RadioButton x:Name="rbReveal"
                                                     Style="{StaticResource MaterialDesignRadioButton}"
                                                     GroupName="FogTool"
                                                     Content="Reveal"
                                                     IsChecked="True"
                                                     Margin="8,0"
                                                     Foreground="White"/>
                                        <RadioButton x:Name="rbCover"
                                                     Style="{StaticResource MaterialDesignRadioButton}"
                                                     GroupName="FogTool"
                                                     Content="Cover"
                                                     Margin="8,0"
                                                     Foreground="White"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                        <Button Content="Reveal All"
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                Click="RevealAll_Click"
                                                Margin="5"
                                                Height="36"
                                                FontSize="13"/>
                                        <Button Content="Reset Fog (R)"
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                Click="ResetFog_Click"
                                                Margin="5"
                                                Height="36"
                                                FontSize="13"/>
                                </StackPanel>

                                <TextBlock Text="Area of Effect Shape"
                                           FontSize="14"
                                           Margin="10,15,10,5"
                                           Foreground="White"/>
                                <ComboBox x:Name="ShapeCombo"
                                          Style="{StaticResource MaterialDesignComboBox}"
                                          Margin="8"
                                          Height="40"
                                          Foreground="White"
                                          SelectedIndex="0"
                                          SelectionChanged="ShapeCombo_SelectionChanged">
                                        <ComboBoxItem>None (fog brush)</ComboBoxItem>
                                        <ComboBoxItem>Circle</ComboBoxItem>
                                        <ComboBoxItem>Square</ComboBoxItem>
                                        <ComboBoxItem>Rectangle</ComboBoxItem>
                                        <ComboBoxItem>Cone</ComboBoxItem>
                                </ComboBox>

                                <TextBlock Text="Condition Marker"
                                           FontSize="14"
                                           Margin="10,15,10,5"
                                           Foreground="White"/>
                                <ComboBox x:Name="ConditionCombo"
                                          Style="{StaticResource MaterialDesignComboBox}"
                                          Margin="8"
                                          Height="40"
                                          Foreground="White"
                                          SelectedIndex="0"
                                          ToolTip="Right-click places this marker. Generic places a CONDITION token.">
                                        <ComboBoxItem>Generic Condition</ComboBoxItem>
                                        <ComboBoxItem>Poisoned</ComboBoxItem>
                                        <ComboBoxItem>Blinded</ComboBoxItem>
                                        <ComboBoxItem>Restrained</ComboBoxItem>
                                        <ComboBoxItem>Prone</ComboBoxItem>
                                        <ComboBoxItem>Paralyzed</ComboBoxItem>
                                        <ComboBoxItem>Stunned</ComboBoxItem>
                                        <ComboBoxItem>Charmed</ComboBoxItem>
                                        <ComboBoxItem>Frightened</ComboBoxItem>
                                        <ComboBoxItem>Incapacitated</ComboBoxItem>
                                </ComboBox>

                                <TextBlock Text="Marker Size"
                                           FontSize="14"
                                           Margin="10,15,10,5"
                                           Foreground="White"/>
                                <StackPanel Orientation="Horizontal" Margin="8">
                                        <RadioButton x:Name="rbSmall"
                                                     Style="{StaticResource MaterialDesignRadioButton}"
                                                     Content="Small"
                                                     IsChecked="True"
                                                     Tag="0.6"
                                                     Margin="8,0"
                                                     Foreground="White"/>
                                        <RadioButton x:Name="rbMedium"
                                                     Style="{StaticResource MaterialDesignRadioButton}"
                                                     Content="Medium"
                                                     Tag="1.0"
                                                     Margin="8,0"
                                                     Foreground="White"/>
                                        <RadioButton x:Name="rbLarge"
                                                     Style="{StaticResource MaterialDesignRadioButton}"
                                                     Content="Large"
                                                     Tag="1.5"
                                                     Margin="8,0"
                                                     Foreground="White"/>
                                </StackPanel>

                                <Button Content="Clear markers &amp; shapes"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Click="ClearOverlays_Click"
                                        Margin="8"
                                        Height="40"
                                        FontSize="14"/>

                                <TextBlock Text="Controls:"
                                           Margin="10,20,10,5"
                                           Foreground="#CCC"
                                           FontSize="13"/>
                                <TextBlock Text="• Left Drag = Reveal or Cover fog"
                                           Margin="10,2"
                                           Foreground="#AAA"/>
                                <TextBlock Text="• Shift + Left Drag = Pan"
                                           Margin="10,2"
                                           Foreground="#AAA"/>
                                <TextBlock Text="• Mouse Wheel = Zoom"
                                           Margin="10,2"
                                           Foreground="#AAA"/>
                                <TextBlock Text="• Shape selected: click to place AoE"
                                           Margin="10,2"
                                           Foreground="#AAA"/>
                                <TextBlock Text="• Wheel on AoE = Resize; Shift+Wheel = Rotate"
                                           Margin="10,2"
                                           Foreground="#AAA"/>
                                <TextBlock Text="• Ctrl+Wheel = Zoom (always)"
                                           Margin="10,2"
                                           Foreground="#AAA"/>
                                <TextBlock Text="• Right Click = Place Marker"
                                           Margin="10,2"
                                           Foreground="#AAA"/>
                                <TextBlock Text="• Shift + Right Click = Delete Marker"
                                           Margin="10,2"
                                           Foreground="#AAA"/>
                                <TextBlock Text="• Ctrl+Z = Undo marker/shape"
                                           Margin="10,2"
                                           Foreground="#AAA"/>
                        </StackPanel>
                </ScrollViewer>

                <skia:SKElement x:Name="skControl"
                                Grid.Column="1"
                                PaintSurface="SkControl_PaintSurface"
                                MouseDown="SkControl_MouseDown"
                                MouseMove="SkControl_MouseMove"
                                MouseUp="SkControl_MouseUp"
                                MouseWheel="SkControl_MouseWheel"
                                LostMouseCapture="SkControl_LostMouseCapture"
                                SizeChanged="SkControl_SizeChanged"/>
        </Grid>
</Window>

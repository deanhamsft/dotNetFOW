<Window x:Class="rpgFogOfWar.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="Control (DM Screen)" Height="800" Width="1200"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menu -->
        <StackPanel Grid.Column="0" Background="#222">
            <TextBlock Text="Tools" FontSize="18" Margin="10" Foreground="White"/>
            <Button Content="Load Image" Click="LoadImage_Click" Margin="5"/>
            <ComboBox x:Name="ShapeCombo" Margin="5" SelectedIndex="0">
                <ComboBoxItem>Circle</ComboBoxItem>
                <ComboBoxItem>Square</ComboBoxItem>
                <ComboBoxItem>Cone</ComboBoxItem>
                <ComboBoxItem>Rectangle</ComboBoxItem>
            </ComboBox>
            <TextBlock Text="Marker Size" Margin="5,10,5,5" Foreground="White"/>
            <StackPanel Orientation="Horizontal" Margin="5">
                <RadioButton x:Name="rbSmall" Content="Small" IsChecked="True" Tag="0.5"/>
                <RadioButton x:Name="rbMedium" Content="Medium" Tag="1.0" Margin="10,0"/>
                <RadioButton x:Name="rbLarge" Content="Large" Tag="1.5"/>
            </StackPanel>
            <Button Content="Clear All" Click="ClearAll_Click" Margin="5"/>
        </StackPanel>

        <!-- Skia Rendering Area -->
        <skia:SKElement x:Name="skControl" Grid.Column="1"
                        PaintSurface="SkControl_PaintSurface"
                        MouseDown="SkControl_MouseDown"
                        MouseMove="SkControl_MouseMove"
                        MouseUp="SkControl_MouseUp"
                        MouseWheel="SkControl_MouseWheel"/>
    </Grid>
</Window>
<Window x:Class="rpgFogOfWar.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="Control (DM Screen)"
        Height="950"
        Width="1350"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">

        <Grid>
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="325"/>
                        <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Menu -->
                <StackPanel Grid.Column="0"
                            Margin="10">
                        <StackPanel.Background>
                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="1,1">
                                        <GradientStop Color="#FF1E3A8A"
                                                      Offset="0.0"/>
                                        <!-- Dark blue -->
                                        <GradientStop Color="#FF3B82F6"
                                                      Offset="0.5"/>
                                        <!-- Bright blue -->
                                        <GradientStop Color="#FF60A5FA"
                                                      Offset="1.0"/>
                                        <!-- Light blue -->
                                </LinearGradientBrush>
                        </StackPanel.Background>

                        <TextBlock Text="FOW Battle Map Tool"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="10,10,10,20"
                                   Foreground="White"/>

                        <Button Content="Load Image (F)"
                                Click="LoadImage_Click"
                                Margin="5"
                                Height="40"
                                FontSize="14"/>
                        <StackPanel Orientation="Horizontal">
                                <Button Content="Save state (ctl-s)"
                                        Click="SaveSession_Click"
                                        Margin="5"
                                        Height="40"
                                        FontSize="14"/>

                                <Button Content="Load state (ctl-o)"
                                        Click="LoadSession_Click"
                                        Margin="5"
                                        Height="40"
                                        FontSize="14"/>
                        </StackPanel>
                        <!-- Shape Selector -->
                        <TextBlock Text="Area of Effect Shape"
                                   FontSize="14"
                                   Margin="10,15,10,5"
                                   Foreground="White"/>
                        <ComboBox x:Name="ShapeCombo"
                                  Margin="8"
                                  Height="40"
                                  SelectedIndex="0"
                                  SelectionChanged="ShapeCombo_SelectionChanged">
                                <ComboBoxItem>None (Disable Shape)</ComboBoxItem>
                                <ComboBoxItem>Circle</ComboBoxItem>
                                <ComboBoxItem>Square</ComboBoxItem>
                                <ComboBoxItem>Rectangle</ComboBoxItem>
                                <ComboBoxItem>Cone</ComboBoxItem>
                        </ComboBox>

                        <!-- Condition Marker -->
                        <TextBlock Text="Condition Marker"
                                   FontSize="14"
                                   Margin="10,15,10,5"
                                   Foreground="White"/>
                        <ComboBox x:Name="ConditionCombo"
                                  Margin="8"
                                  Height="40"
                                  SelectedIndex="0">
                                <ComboBoxItem>Generic Condition</ComboBoxItem>
                                <ComboBoxItem>Poisoned</ComboBoxItem>
                                <ComboBoxItem>Blinded</ComboBoxItem>
                                <ComboBoxItem>Restrained</ComboBoxItem>
                                <ComboBoxItem>Prone</ComboBoxItem>
                                <ComboBoxItem>Paralyzed</ComboBoxItem>
                                <ComboBoxItem>Stunned</ComboBoxItem>
                                <ComboBoxItem>Charmed</ComboBoxItem>
                                <ComboBoxItem>Frightened</ComboBoxItem>
                                <ComboBoxItem>Incapacitated</ComboBoxItem>
                        </ComboBox>

                        <TextBlock Text="Marker Size"
                                   FontSize="14"
                                   Margin="10,15,10,5"
                                   Foreground="White"/>
                        <StackPanel Orientation="Horizontal"
                                    Margin="8">
                                <RadioButton x:Name="rbSmall"
                                             Content="Small"
                                             IsChecked="True"
                                             Tag="0.6"
                                             Margin="8,0"
                                             Foreground="White"/>
                                <RadioButton x:Name="rbMedium"
                                             Content="Medium"
                                             Tag="1.0"
                                             Margin="8,0"
                                             Foreground="White"/>
                                <RadioButton x:Name="rbLarge"
                                             Content="Large"
                                             Tag="1.5"
                                             Margin="8,0"
                                             Foreground="White"/>
                        </StackPanel>

                        <Button Content="Clear All"
                                Click="ClearAll_Click"
                                Margin="8"
                                Height="40"
                                FontSize="14"/>

                        <TextBlock Text="Controls:"
                                   Margin="10,20,10,5"
                                   Foreground="#CCC"
                                   FontSize="13"/>
                        <TextBlock Text="• Left Drag = Reveal Fog"
                                   Margin="10,2"
                                   Foreground="#AAA"/>
                        <TextBlock Text="• Right Click = Place Marker"
                                   Margin="10,2"
                                   Foreground="#AAA"/>
                        <TextBlock Text="• Shift + Right Click = Delete Marker"
                                   Margin="10,2"
                                   Foreground="#AAA"/>
                        <TextBlock Text="• Mouse Wheel = Resize Shape / Zoom Map"
                                   Margin="10,2"
                                   Foreground="#AAA"/>
                        <TextBlock Text="• Shift + Wheel = Rotate Shape"
                                   Margin="10,2"
                                   Foreground="#AAA"/>
                </StackPanel>

                <!-- Canvas Area -->
                <skia:SKElement x:Name="skControl"
                                Grid.Column="1"
                                PaintSurface="SkControl_PaintSurface"
                                MouseDown="SkControl_MouseDown"
                                MouseMove="SkControl_MouseMove"
                                MouseUp="SkControl_MouseUp"
                                MouseWheel="SkControl_MouseWheel"/>
        </Grid>
</Window>